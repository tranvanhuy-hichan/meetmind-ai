# Sao chép thành .env (hoặc chạy `make setup` để tự tạo với khóa ngẫu nhiên).
MEETMIND_JWT_SECRET=change-me-to-a-long-random-string

# MinIO đã cài trên máy. Tài khoản cần quyền đọc, ghi, xóa object và tạo bucket (hoặc tạo sẵn bucket).
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=meetmind

# PostgreSQL đã cài trên máy. Tạo người dùng và cơ sở dữ liệu trước: xem `make db-help`.
DATABASE_URL=postgresql+asyncpg://meetmind:CHANGE_ME@localhost:5432/meetmind

# Gửi mã đăng nhập và lời mời bằng email thật (chỉ cần khi config.yaml đặt email.adapter: smtp).
SMTP_USERNAME=
SMTP_PASSWORD=

# Đăng nhập bằng Google. Client ID là mã công khai (không phải bí mật), lấy từ Google Cloud Console > Credentials.
# Trong "Authorized JavaScript origins" của client này phải có địa chỉ web của MeetMind (ví dụ http://localhost:3000).
GOOGLE_CLIENT_ID=334563412386-cgjjso3vum67fdaqnl1lh2u70b2gea5c.apps.googleusercontent.com
# Chỉ cho phép một số tên miền email, ví dụ ["congty.com"]. Để trống = mọi tài khoản Google.
# Tạo phòng Meet từ MeetMind: cần thêm client secret (bí mật, không chia sẻ) và địa chỉ API mà trình duyệt thấy.
# Trong Google Console, mục Authorized redirect URIs phải có: <PUBLIC_API_URL>/api/google/callback
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:8000
GOOGLE_ALLOWED_DOMAINS=[]
# Đăng nhập bằng mã gửi qua email: auto (chỉ khi chưa có Google) | on | off
EMAIL_CODE=on

# Bot vào Google Meet: attendee = thật (mặc định, `make up` tự dựng Attendee và tạo khóa) | fake = cuộc họp mẫu (`make up-demo`).
BOT_ADAPTER=attendee
ATTENDEE_URL=http://localhost:8010
ATTENDEE_API_KEY=
# Ngôn ngữ phụ đề của Meet (một ngôn ngữ cho cả cuộc họp), ví dụ vi-VN, en-US, ja-JP.
MEET_CAPTION_LANG=vi-VN
